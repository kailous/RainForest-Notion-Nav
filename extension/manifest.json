{
  "manifest_version": 3,
  "name": "RainForest Navigator",
  "version": "1.0.0",
  "description": "本地导航 + 快速访问",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "RainForest Navigator"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
